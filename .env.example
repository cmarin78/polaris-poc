# polaris POC — Phase 2 environment template.
# Copy this file to .env and fill in the values. None of these are placeholders
# in a real run; the POC refuses to start without them.

# =============================================================================
# Headscale (control plane for Tailscale)
# =============================================================================

# 28080 instead of 18080 because port 18080 is already taken by the
# headscaletest-poc container on this host.
HEADSCALE_URL=http://host.docker.internal:28080

# MagicDNS base domain. Every node becomes <hostname>.polaris.ts.net
HEADSCALE_BASE_DOMAIN=polaris.ts.net

# =============================================================================
# Tailscale preauth keys (one per sidecar tag)
# Generate with:
#   docker exec polaris-poc-headscale-1 \
#       headscale preauthkeys create --user polaris --reusable \
#           --expiration 720h --tags tag:<tag-name>
# 8 keys total: pol-intranet, pol-grafana, pol-customer-acme, pol-customer-brightside,
# pol-partners-northwind, pol-admin, pol-ops, pol-minio
# =============================================================================

TS_AUTHKEY_POL_INTRANET=hskey-auth-PLACEHOLDER-POL-INTRANET
TS_AUTHKEY_POL_GRAFANA=hskey-auth-PLACEHOLDER-POL-GRAFANA
TS_AUTHKEY_POL_CUSTOMER_ACME=hskey-auth-PLACEHOLDER-POL-CUSTOMER-ACME
TS_AUTHKEY_POL_CUSTOMER_BRIGHT=hskey-auth-PLACEHOLDER-POL-CUSTOMER-BRIGHT
TS_AUTHKEY_POL_PARTNERS_NORTHWIND=hskey-auth-PLACEHOLDER-POL-PARTNERS-NORTHWIND
TS_AUTHKEY_POL_MINIO=hskey-auth-PLACEHOLDER-POL-MINIO

# Demo user-side device keys (for testing portal login from outside the cluster)
TS_AUTHKEY_USER_ALICE=hskey-auth-PLACEHOLDER-USER-ALICE
TS_AUTHKEY_USER_BOB=hskey-auth-PLACEHOLDER-USER-BOB
TS_AUTHKEY_USER_CAROL=hskey-auth-PLACEHOLDER-USER-CAROL

# =============================================================================
# Keycloak (OIDC IDP)
# =============================================================================
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_admin_password
KEYCLOAK_REALM=polaris

# =============================================================================
# Postgres (RDS sim)
# =============================================================================
POSTGRES_DB=polaris
POSTGRES_USER=polaris_admin
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# =============================================================================
# MinIO (S3 sim with IAM)
# =============================================================================
MINIO_ROOT_USER=polaris_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_root_password